{
  "name": "lvl222-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "server.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "build": "node --check server.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "publish:downloads": "node --env-file=.env.local scripts/publish-blob.mjs",
    "sync:releases": "node scripts/sync-releases.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.8.0"
  }
}
