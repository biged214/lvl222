{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "functions": { "api/sync.mjs": { "maxDuration": 300 } },
  "crons": [{ "path": "/api/sync", "schedule": "0 9 * * *" }],
  "rewrites": [
    { "source": "/downloads/sc-companion/:path*", "destination": "https://tscultkr7b7rgwsw.public.blob.vercel-storage.com/downloads/sc-companion/:path*" },
    { "source": "/downloads", "destination": "/api/page?kind=downloads" },
    { "source": "/source", "destination": "/api/page?kind=source" },
    { "source": "/api/release", "destination": "/api/page?kind=release" },
    { "source": "/updates/sc-companion/latest.json", "destination": "/api/page?kind=updater" }
  ],
  "headers": [
    { "source": "/downloads/sc-companion/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/updates/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/health", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'" }
    ] }
  ]
}
